# cmsmcp M1 configuration. Complex lists use JSON syntax.
# Do not put cookies, bearer tokens, or other secrets in this file.

# The default state directory is $XDG_STATE_HOME/cmsmcp or ~/.local/state/cmsmcp.
# Override only with an absolute path; Path values do not expand ~.
# CMSMCP_STATE_DIR=/absolute/path/to/cmsmcp/state

CMSMCP_SSO_START_URL=https://indico.cern.ch/user/dashboard/
CMSMCP_SSO_IDENTITY_HOST=auth.cern.ch
CMSMCP_BROWSER_TYPE=chromium
# CMSMCP_BROWSER_EXECUTABLE=/usr/bin/chromium
CMSMCP_SSO_TIMEOUT_SECONDS=180
CMSMCP_SESSION_MAX_AGE_SECONDS=86400
CMSMCP_IDENTITY_COOKIE_NAMES=["KEYCLOAK_IDENTITY"]
CMSMCP_ALLOWED_HOSTS=["cern.ch","*.cern.ch","inspirehep.net","*.inspirehep.net"]
CMSMCP_REQUEST_TIMEOUT_SECONDS=30
CMSMCP_MAX_RESPONSE_BYTES=10485760
CMSMCP_MAX_DOWNLOAD_BYTES=52428800
CMSMCP_REQUIRE_SSO=true

# M2 adapter endpoints and optional service tokens.
# Tokens are read from the process environment only; keep this file out of
# version control when a token is set locally.
CMSMCP_INDICO_BASE_URL=https://indico.cern.ch
# CERN Indico personal API token (Bearer). Without it the legacy export API
# cannot see protected events/categories and reports them as "not found".
# CMSMCP_INDICO_API_TOKEN=
CMSMCP_INSPIRE_BASE_URL=https://inspirehep.net/api
CMSMCP_GITLAB_BASE_URL=https://gitlab.cern.ch
# CMSMCP_GITLAB_TOKEN=
CMSMCP_CDS_BASE_URL=https://cds.cern.ch
CMSMCP_HLTINFO_BASE_URL=https://cmshltinfo-dev.app.cern.ch
# CMSMCP_HLTINFO_TOKEN=
CMSMCP_GLANCE_BASE_URL=https://cmsfence.cern.ch
# Optional manual fallbacks for the GLANCE Bearer tokens; normally captured
# automatically by cern_auth_sign_in from the cmsfence SPAs.
# CMSMCP_GLANCE_ALCM_TOKEN=
# CMSMCP_GLANCE_MEMBERSHIP_TOKEN=
# glance_search_notes fetches one ~15 MB index; it needs a raise like:
# CMSMCP_MAX_RESPONSE_BYTES=20971520
# Mattermost (mattermost.web.cern.ch) normally authenticates with the
# MMAUTHTOKEN cookie minted automatically from the SSO session. An optional
# personal access token (profile -> Security -> Personal Access Tokens)
# overrides it as Authorization: Bearer.
CMSMCP_MATTERMOST_BASE_URL=https://mattermost.web.cern.ch
# CMSMCP_MATTERMOST_TOKEN=
# CERN Phonebook (phonebook.cern.ch, the backend of directory.web.cern.ch):
# the Bearer token is minted automatically from the SSO session on first use
# (Keycloak public client "phonebook"); set this only as a manual override.
CMSMCP_PHONEBOOK_APP_URL=https://phonebook.cern.ch/
# CMSMCP_PHONEBOOK_TOKEN=

# Grid client certificate for the cmsweb-certificate services (CMS DAS via
# dasgoclient, CMS DQM GUI at cmsweb.cern.ch/dqm): an X509 grid credential,
# e.g. ~/.globus/usercert.pem + userkey.pem or a voms-proxy-init proxy.
# Defaults are exactly those two files; the proxy path below is typical.
# CMSMCP_GRID_CERT_FILE=/tmp/x509up_u1000
# CMSMCP_GRID_KEY_FILE=/tmp/x509up_u1000
# CMSMCP_GRID_CERT_HOSTS=["cmsweb.cern.ch"]
