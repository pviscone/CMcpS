# CMcpS M1 configuration. Complex lists use JSON syntax.
# Do not put cookies, bearer tokens, or other secrets in this file.

# The default state directory is $XDG_STATE_HOME/cmcps or ~/.local/state/cmcps.
# Override only with an absolute path; Path values do not expand ~.
# CMCPS_STATE_DIR=/absolute/path/to/cmcps/state

CMCPS_SSO_START_URL=https://indico.cern.ch/user/dashboard/
CMCPS_SSO_IDENTITY_HOST=auth.cern.ch
CMCPS_BROWSER_TYPE=chromium
# CMCPS_BROWSER_EXECUTABLE=/usr/bin/chromium
CMCPS_SSO_TIMEOUT_SECONDS=180
CMCPS_SESSION_MAX_AGE_SECONDS=86400
CMCPS_IDENTITY_COOKIE_NAMES=["KEYCLOAK_IDENTITY"]
CMCPS_ALLOWED_HOSTS=["cern.ch","*.cern.ch","inspirehep.net","*.inspirehep.net"]
CMCPS_REQUEST_TIMEOUT_SECONDS=30
CMCPS_MAX_RESPONSE_BYTES=10485760
CMCPS_MAX_DOWNLOAD_BYTES=52428800
CMCPS_REQUIRE_SSO=true

# M2 adapter endpoints and optional service tokens.
# Tokens are read from the process environment only; keep this file out of
# version control when a token is set locally.
CMCPS_INDICO_BASE_URL=https://indico.cern.ch
# CERN Indico personal API token (Bearer). Without it the legacy export API
# cannot see protected events/categories and reports them as "not found".
# CMCPS_INDICO_API_TOKEN=
CMCPS_INSPIRE_BASE_URL=https://inspirehep.net/api
CMCPS_GITLAB_BASE_URL=https://gitlab.cern.ch
# CMCPS_GITLAB_TOKEN=
CMCPS_CDS_BASE_URL=https://cds.cern.ch
CMCPS_HLTINFO_BASE_URL=https://cmshltinfo-dev.app.cern.ch
# CMCPS_HLTINFO_TOKEN=
CMCPS_GLANCE_BASE_URL=https://cmsfence.cern.ch
# Optional manual fallbacks for the GLANCE Bearer tokens; normally captured
# automatically by cern_auth_sign_in from the cmsfence SPAs.
# CMCPS_GLANCE_ALCM_TOKEN=
# CMCPS_GLANCE_MEMBERSHIP_TOKEN=
# glance_search_notes fetches one ~15 MB index; it needs a raise like:
# CMCPS_MAX_RESPONSE_BYTES=20971520
# Mattermost (mattermost.web.cern.ch) normally authenticates with the
# MMAUTHTOKEN cookie minted automatically from the SSO session. An optional
# personal access token (profile -> Security -> Personal Access Tokens)
# overrides it as Authorization: Bearer.
CMCPS_MATTERMOST_BASE_URL=https://mattermost.web.cern.ch
# CMCPS_MATTERMOST_TOKEN=

# Grid client certificate for the cmsweb-certificate services (CMS DAS via
# dasgoclient, CMS DQM GUI at cmsweb.cern.ch/dqm): an X509 grid credential,
# e.g. ~/.globus/usercert.pem + userkey.pem or a voms-proxy-init proxy.
# Defaults are exactly those two files; the proxy path below is typical.
# CMCPS_GRID_CERT_FILE=/tmp/x509up_u1000
# CMCPS_GRID_KEY_FILE=/tmp/x509up_u1000
# CMCPS_GRID_CERT_HOSTS=["cmsweb.cern.ch"]
